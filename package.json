{
  "name": "cuphead-web-project",
  "version": "2.0.0",
  "description": "A 1930s cartoon-style Cuphead tribute web project - Vue Edition",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest --config config/vitest.config.js",
    "test:ui": "vitest --ui --config config/vitest.config.js",
    "lint": "eslint src/**/*.{js,vue} --config config/eslint.config.js",
    "format": "prettier --write src/**/*.{js,vue,css,html} --config config/.prettierrc"
  },
  "keywords": [
    "cuphead",
    "game",
    "unity",
    "webgl",
    "vintage",
    "vue"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "vue": "^3.4.0",
    "vue-router": "^4.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0"
  }
}
